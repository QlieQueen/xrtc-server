{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/third_party/include",
                "${workspaceFolder}/../rtcbase/src"
            ],
            "defines": [
                "WEBRTC_POSIX",
                "WEBRTC_LINUX"
            ],
            "cStandard": "c11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}
